      "title": "Explicit Approval Required (v2)",
      "summary": "If external_or_state_changing is true and status is approved or completed, then approval.required, approval.explicit, and approval.prior_to_execution must all be true.",
      "payload": {
        "logic_payload": {
          "if": [
            { "and": [
              { "var": "action.external_or_state_changing" },
              { "in": [ { "var": "action.status" }, [ "approved", "completed" ] ] }
            ] },
            { "and": [
              { "var": "action.approval.required" },
              { "var": "action.approval.explicit" },
              { "var": "action.approval.prior_to_execution" }
            ] },
            "PASS"
          ]
        }
      },
